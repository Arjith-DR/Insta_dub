    { "key": "token", "value": "", "type": "string" },
    { "key": "userId", "value": "1", "type": "string" },
    { "key": "secondUserId", "value": "2", "type": "string" },
    { "key": "roleId", "value": "1", "type": "string" },
    { "key": "postId", "value": "1", "type": "string" },
