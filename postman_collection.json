  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.access_token) pm.collectionVariables.set('token', json.access_token);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@example.com\",\n  \"password\": \"password123\"\n}"
            },
            "url": "{{baseUrl}}/auth/login"
          }
        }
      ]
    },
    {
      "name": "Users",
      "item": [
        {
          "name": "Create User",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "  const json = pm.response.json();",
                  "  if (json.user_id) pm.collectionVariables.set('userId', json.user_id);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"role_id\": 1,\n  \"email\": \"demo@example.com\",\n  \"password\": \"password123\",\n  \"status\": \"active\"\n}"
            },
            "url": "{{baseUrl}}/users/"
          }
        },
        {
          "name": "List Users",
          "request": { "method": "GET", "url": "{{baseUrl}}/users/" }
        },
        {
          "name": "Update User Status",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/status?new_status=active",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "status"],
              "query": [{ "key": "new_status", "value": "active" }]
            }
          }
        },
        {
          "name": "Change Password",
          "request": {
            "method": "PUT",
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/password?old_password=password123&new_password=newpassword123",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "password"],
              "query": [
                { "key": "old_password", "value": "password123" },
                { "key": "new_password", "value": "newpassword123" }
              ]
            }
          }
        },
        {
          "name": "Log Password Change",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{baseUrl}}/users/{{userId}}/password/log?old_password=password123&new_password=newpassword123",
              "host": ["{{baseUrl}}"],
              "path": ["users", "{{userId}}", "password", "log"],
              "query": [
                { "key": "old_password", "value": "password123" },
                { "key": "new_password", "value": "newpassword123" }
              ]
            }
          }
        },
        {
          "name": "Password History",
          "request": { "method": "GET", "url": "{{baseUrl}}/users/{{userId}}/password/history" }
        },
        {
          "name": "Change Username",
          "request": {
            "method": "PUT",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": { "mode": "raw", "raw": "{\n  \"new_username\": \"demo_user\"\n}" },
            "url": "{{baseUrl}}/users/{{userId}}/username"
          }
        },
        {
          "name": "Delete User",
          "request": { "method": "DELETE", "url": "{{baseUrl}}/users/{{userId}}" }
        }
      ]
    },
